<UserControl x:Class="BusParkDispatcher.Views.PasswordRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BusParkDispatcher.Views"
             xmlns:controls="clr-namespace:BusParkDispatcher.Controls"
             xmlns:vm="clr-namespace:BusParkDispatcher.ViewModels"
             mc:Ignorable="d"
             Height="125" Width="400" Background="Transparent">
    <UserControl.DataContext>
        <vm:PasswordRecoveryViewModel />
    </UserControl.DataContext>
    <UserControl.InputBindings>
        <KeyBinding Key="Return" Command="{Binding Recovery}" CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" />
    </UserControl.InputBindings>
    <Grid Width="Auto" Height="Auto">
        <Border Background="White" CornerRadius="5" BorderThickness="2" BorderBrush="{Binding BorderBrush, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="15"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"  Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Пароль будет отправлен на почту " FontSize="12"/>
                <TextBlock Text="{Binding Email, Mode=OneWay}" FontSize="12" FontWeight="DemiBold"/>
            </StackPanel>

            <controls:CornerTextBox Grid.Row="1" Style="{StaticResource CornerBorderDownTextBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" WatermarkText="Введите почту, привязанную к аккаунту" Width="250" HorizontalContentAlignment="Center"/>

            <TextBlock Grid.Row="2" Text="Нажмите Enter чтобы продолжить......" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="10"/>
        </Grid>
    </Grid>
</UserControl>
